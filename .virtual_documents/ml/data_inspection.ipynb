import joblib
from pathlib import Path

# Create model directory
MODEL_DIR = Path("model")
MODEL_DIR.mkdir(exist_ok=True)

# Save trained XGBoost model
joblib.dump(
    final_model,
    MODEL_DIR / "xgb_burnout_model.pkl"
)

# Save fitted preprocessor
joblib.dump(
    preprocessor,
    MODEL_DIR / "preprocessor.pkl"
)

# Save feature names
joblib.dump(
    list(X_train.columns),
    MODEL_DIR / "feature_names.pkl"
)

print("Model saved successfully!")
print("Saved files:")

for file in MODEL_DIR.iterdir():
    print(file)


import joblib
import shap
import pandas as pd
from pathlib import Path

# Load saved files
MODEL_DIR = Path("model")

final_model = joblib.load(
    MODEL_DIR / "xgb_burnout_model.pkl"
)

preprocessor = joblib.load(
    MODEL_DIR / "preprocessor.pkl"
)

feature_names = joblib.load(
    MODEL_DIR / "feature_names.pkl"
)

print("Model loaded successfully!")
print("Number of input features:", len(feature_names))


# Create SHAP explainer
explainer = shap.TreeExplainer(final_model)

print("SHAP explainer created successfully!")


# Take 100 samples from the test dataset
X_sample = X_test.iloc[:100]

# Apply the same preprocessing used during training
X_sample_processed = preprocessor.transform(X_sample)

# Calculate SHAP values
shap_values = explainer.shap_values(
    X_sample_processed
)

print("SHAP values calculated successfully!")
print("SHAP shape:", shap_values.shape)


shap.summary_plot(
    shap_values,
    X_sample_processed,
    feature_names=preprocessor.get_feature_names_out()
)


shap.summary_plot(
    shap_values,
    X_sample_processed,
    feature_names=preprocessor.get_feature_names_out(),
    plot_type="bar"
)


print("SHAP shape:", shap_values.shape)


# Select one user from the test dataset
sample_index = 0

sample = X_test.iloc[[sample_index]]

# Transform the sample
sample_processed = preprocessor.transform(sample)

# Predict burnout score
predicted_score = final_model.predict(sample_processed)[0]

print("Predicted Burnout Score:", round(predicted_score, 2))


# Calculate SHAP values for this user
sample_shap_values = explainer.shap_values(
    sample_processed
)

# Create SHAP explanation object
explanation = shap.Explanation(
    values=sample_shap_values[0],
    base_values=explainer.expected_value,
    data=sample_processed.toarray()[0]
        if hasattr(sample_processed, "toarray")
        else sample_processed[0],
    feature_names=preprocessor.get_feature_names_out()
)

# Display waterfall plot
shap.plots.waterfall(explanation)



