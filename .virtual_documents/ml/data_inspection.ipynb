shap.summary_plot(
    shap_values,
    X_test_processed,
    feature_names=feature_names
)


shap.summary_plot(
    shap_values,
    X_test_processed,
    feature_names=feature_names,
    plot_type="bar"
)


sample_index = 0

sample = X_test_processed[sample_index]


sample_shap = shap_values[sample_index]

print("Actual burnout score:", y_test.iloc[sample_index])
print("Predicted burnout score:", y_pred_xgb[sample_index])


shap.waterfall_plot(
    shap.Explanation(
        values=sample_shap,
        base_values=explainer.expected_value,
        data=sample,
        feature_names=feature_names
    )
)


